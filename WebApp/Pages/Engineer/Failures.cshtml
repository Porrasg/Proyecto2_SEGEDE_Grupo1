@page
@model SEGEDE_Grupo1.WebApp.Pages.Engineer.FailuresModel
@{
    ViewData["Title"] = "Registro y Análisis de Fallas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>
    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
        <div class="d-flex flex-wrap gap-2">
            <select class="form-select" id="engFailTurbine" style="max-width: 300px;">
                <option value="">Todas las Turbinas</option>
                </select>
            <select class="form-select" id="engFailSeverity" style="max-width: 190px;">
                <option value="">Todas las severidades</option>
                <option value="Low">Baja</option>
                <option value="Medium">Media</option>
                <option value="High">Alta</option>
                <option value="Critical">Crítica</option>
            </select>
        </div>
        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#regFailModal">+ Reportar Falla</button>
    </div>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Turbina</th>
                    <th>Severidad</th>
                    <th>Estado</th>
                    <th>Descripción</th>
                    <th>Fecha Reporte</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody id="engFailsBody">
                <tr>
                    <td colspan="7" class="text-center">
                        Cargando fallas...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- Modal Falla -->
    <div class="modal fade" id="regFailModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Reportar Falla de Turbina</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar diálogo"></button></div><div class="modal-body"><form id="regFailForm" novalidate><div class="mb-2"><label class="form-label" for="fTurbine">Turbina</label><select class="form-select" id="fTurbine" required></select></div><div class="mb-2"><label class="form-label" for="fSeverity">Severidad</label><select class="form-select" id="fSeverity" required><option value="Low">Baja</option><option value="Medium" selected>Media</option><option value="High">Alta</option><option value="Critical">Crítica</option></select><small class="text-danger d-block mt-1">¡Atención! Una falla Crítica cambiará el estado de la turbina a Dañada inmediatamente.</small></div><div class="mb-2"><label class="form-label" for="fDesc">Descripción técnica</label><textarea class="form-control" id="fDesc" minlength="10" maxlength="500" rows="4" required></textarea><div class="form-text">Incluya síntomas, condiciones y evidencia observada (10–500 caracteres).</div></div></form></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-danger" id="saveFailBtn">Reportar</button></div></div></div></div>
</div>

@section Scripts {
    <script src="~/js/pages-controller/OperationsComplementaryViewController.js" asp-append-version="true"></script>
}
