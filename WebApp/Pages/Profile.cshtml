@page
@model SEGEDE_Grupo1.WebApp.Pages.ProfileModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div class="row g-4">
                    <h5 id="profName">-</h5>
                    </div>
                </div>
            </div>
                <div class="card-body">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="pFirstLastName">Primer Apellido</label>
                                <input type="text" class="form-control" id="pFirstLastName" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="pSecondLastName">Segundo Apellido</label>
                                <input type="text" class="form-control" id="pSecondLastName">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="pEmail">Correo Electrónico</label>
                                <input type="email" class="form-control" id="pEmail" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="pPhone">Teléfono de Contacto</label>
                                <input type="tel" class="form-control" id="pPhone" required>
                            </div>
            

}
