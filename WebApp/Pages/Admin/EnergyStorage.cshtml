@page
@model SEGEDE_Grupo1.WebApp.Pages.Admin.EnergyStorageModel
@{
    ViewData["Title"] = "Operación y Cortes - Almacenamiento";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="h6">Monitoreo de Baterías Locales</h2>
            <div id="batteriesGrid" class="d-flex flex-wrap gap-3">
                <!-- Cards se insertan por JS -->
            </div>
        </div>

        <div class="col-md-4">
            <h2 class="h6">Estado Banco Central</h2>
            <div class="card p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="text-muted fs-xs">Inventario Actual</div>
                        <div id="cbInventory" class="fs-4 fw-bold">-- MWh</div>
                    </div>
                    <div>
                        <button id="btnFlush" class="btn btn-danger">Ejecutar Flush Manual</button>
                    </div>
                </div>

                <div class="mt-2">
                    <div class="text-muted fs-xs">Capacidad Máxima</div>
                    <div class="progress" style="height:1.25rem;">
                        <div id="cbProgress" class="progress-bar" role="progressbar" style="width:0%" aria-valuemin="0" aria-valuemax="100">0%</div>
                    </div>
                    <div id="cbCapacityText" class="text-muted fs-xs mt-1">-- / -- MWh</div>
                </div>
            </div>

            <h2 class="h6">Acciones</h2>
            <div class="card p-3 mb-3">
                <p class="mb-2">Calcula la producción neta de cada turbina desde el último corte (capacidad nominal menos horas de mantenimiento/inactividad) y la acredita a su batería.</p>
                <button id="btnExecuteProduction" class="btn btn-primary w-100">
                    <i class="bi bi-lightning-charge-fill me-1"></i>Calcular Producción del Periodo
                </button>
            </div>
            <div class="card p-3">
                <p class="mb-2">Acción manual para vaciar todas las baterías locales hacia el Banco Central.</p>
                <button id="btnFlushSmall" class="btn btn-danger w-100">Realizar Vaciado</button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <h2 class="h6">Historial de Flushes</h2>
            <div class="card p-3">
                <table id="flushHistoryTable" class="table table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Fecha de Ejecución</th>
                            <th>Transferido (MWh)</th>
                            <th>Pérdida Saturación (MWh)</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <h2 class="h6">Historial de Producción por Turbina</h2>

        <div class="card p-3">
            <table id="energyProductionTable" class="table table-striped table-hover w-100">
                <thead>
                    <tr>
                        <th>Turbina</th>
                        <th>Inicio del Periodo</th>
                        <th>Fin del Periodo</th>
                        <th>Producción Bruta (MWh)</th>
                        <th>Pérdida Mantenimiento/Inactividad (MWh)</th>
                        <th>Producción Neta (MWh)</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>


@section Scripts {
    <!-- Incrementamos a v=1.3 para forzar la lectura del script con los bloques IF -->
    <script src="~/js/pages-controller/AdminEnergyStorageViewController.js?v=1.5"></script>
}






