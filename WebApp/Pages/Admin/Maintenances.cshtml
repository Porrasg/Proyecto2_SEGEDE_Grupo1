@page
@model SEGEDE_Grupo1.WebApp.Pages.Admin.MaintenancesModel
@{
    ViewData["Title"] = "Visión General de Mantenimientos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>
    <div id="maintComplianceAlert" class="alert alert-warning d-none">
        <i class="bi bi-exclamation-triangle me-1"></i>
        <span id="maintComplianceAlertText"></span>
    </div>
    <div class="card shadow-sm border-0 mb-4" id="maintenanceCalendar">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div class="fw-semibold"><i class="bi bi-calendar3 me-2"></i>Calendario técnico</div>
                <small class="text-muted">Mantenimientos preventivos, correctivos y operativos</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="maintenanceCalendarPrevious" aria-label="Mes anterior"><i class="bi bi-chevron-left"></i></button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="maintenanceCalendarToday">Hoy</button>
                <strong class="maintenance-calendar-title text-center" id="maintenanceCalendarTitle"></strong>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="maintenanceCalendarNext" aria-label="Mes siguiente"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
        <div class="card-body">
            <div class="maintenance-calendar-weekdays" aria-hidden="true"><span>Dom</span><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span></div>
            <div class="maintenance-calendar-grid" id="maintenanceCalendarGrid" aria-label="Calendario mensual de mantenimientos"></div>
            <div class="alert alert-light border mt-3 mb-0 d-none" id="maintenanceCalendarDetail" aria-live="polite"></div>
        </div>
    </div>
        <div class="d-flex justify-content-between mb-3">
        <div class="d-flex gap-2">
            <select class="form-select" id="maintStatus"><option value="">Todos los Estados</option><option value="Scheduled">Programado</option><option value="InProgress">En Progreso</option><option value="Completed">Completado</option></select>
            <select class="form-select" id="maintType"><option value="">Todos los Tipos</option><option value="Preventive">Preventivo</option><option value="Corrective">Correctivo</option><option value="Predictive">Predictivo</option><option value="Inspection">Inspección</option><option value="Emergency">Emergencia</option></select>
        </div>
    </div>
    <table class="table table-bordered">
        <thead><tr><th>ID</th><th>Turbina</th><th>Tipo</th><th>Inicio Estimado</th><th>Fin Estimado</th><th>Estado</th><th>Resultado</th></tr></thead>
        <tbody id="maintsOverviewBody"><tr><td colspan="7" class="text-center">Cargando mantenimientos...</td></tr></tbody>
    </table>
</div>

<!--Modal Creacion horario de Mantenimiento-->
<div class="modal fade" id="scheduleMaintenanceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Programar mantenimiento</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <!--TURBINA-->
                <div class="mb-3">
                    <label class="form-label">Turbina</label>
                    <select class="form-select" id="maintenanceTurbine">
                        <option value="">Seleccione una turbina</option>
                    </select>
                </div>
                <!--Ingerniero Responsable-->
                <div class="mb-3">
                    <label class="form-label">Ingeniero responsable</label>

                    <select class="form-select" id="maintenanceEngineer">
                        <option value="">Seleccione un ingeniero</option>
                    </select>
                </div>

                <!--Tipo Mantenimiento-->
                <div class="mb-3">
                    <label class="form-label">Tipo de mantenimiento</label>
                    <select class="form-select" id="maintenanceType">
                        <option value="Preventive">Preventivo</option>
                        <option value="Corrective">Correctivo</option>
                        <option value="Predictive">Predictivo</option>
                        <option value="Inspection">Inspección</option>
                        <option value="Emergency">Emergencia</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Inicio estimado</label>
                    <input type="datetime-local"
                           class="form-control"
                           id="maintenanceStart">
                </div>

                <div class="mb-3">
                    <label class="form-label">Fin estimado</label>
                    <input type="datetime-local"
                           class="form-control"
                           id="maintenanceEnd">
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="saveMaintenanceBtn">
                    Guardar mantenimiento
                </button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/maintenanceCalendar.js"></script>
    <script src="~/js/pages-controller/AdminMaintenanceFailureViewController.js"></script>
}
