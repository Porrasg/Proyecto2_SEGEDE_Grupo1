@page
@model SEGEDE_Grupo1.WebApp.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2><i class="bi bi-people-fill me-2" style="color: var(--sgde-primary);"></i>@ViewData["Title"]</h2>
            <p class="page-subtitle">Administre usuarios de la plataforma: administradores, ingenieros y compradores.</p>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="filter-toolbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 350px;">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0" id="searchUser" placeholder="Buscar por nombre, correo o cédula...">
            </div>
        </div>
        <div class="filter-chips-container my-2 my-md-0">
            <button type="button" class="filter-chip active" data-status="" data-target="#filterRole"><i class="bi bi-people"></i> Todos</button>
            <button type="button" class="filter-chip" data-status="Administrator" data-target="#filterRole"><i class="bi bi-shield-check text-danger"></i> Administradores</button>
            <button type="button" class="filter-chip" data-status="Engineer" data-target="#filterRole"><i class="bi bi-lightning-charge text-info"></i> Ingenieros</button>
            <button type="button" class="filter-chip" data-status="Distributor" data-target="#filterRole"><i class="bi bi-building text-success"></i> Compradores</button>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <select class="form-select form-select-sm d-none" id="filterRole">
                <option value="">Todos los Roles</option>
                <option value="Administrator">Administrator</option>
                <option value="Engineer">Engineer</option>
                <option value="Distributor">Buyer</option>
            </select>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearFilters" title="Limpiar filtros"><i class="bi bi-x-circle me-1"></i> Limpiar</button>
            <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center gap-1" id="btnOpenNewUser"><i class="bi bi-person-plus-fill"></i> Nuevo Usuario</button>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-interactive mb-0 align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>Identificación</th>
                            <th>Nombre</th>
                            <th>Edad</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        <tr><td colspan="8" class="text-center py-4 text-muted">Cargando usuarios...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- User Modal (Create / Edit) -->
    <div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="userModalLabel">
                        <i class="bi bi-person-gear me-2"></i>Usuario Interno
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="userForm" novalidate>
                        <!-- Row 1: Identificación + Correo -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="uId">
                                    <i class="bi bi-person-vcard me-1"></i>Identificación
                                </label>
                                <input type="text" class="form-control" id="uId" required placeholder="Ej. 118230456">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="uEmail">
                                    <i class="bi bi-envelope me-1"></i>Correo Electrónico
                                </label>
                                <input type="email" class="form-control" id="uEmail" required placeholder="Ej. usuario@empresa.cr">
                            </div>
                        </div>

                        <!-- Row 2: Nombres + Apellidos -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label" for="uFullName">Nombres</label>
                                <input type="text" class="form-control" id="uFullName" required placeholder="Ej. Juan Carlos">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="uLast1">Apellido 1</label>
                                <input type="text" class="form-control" id="uLast1" required placeholder="Ej. Pérez">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="uLast2">Apellido 2</label>
                                <input type="text" class="form-control" id="uLast2" placeholder="Ej. Rodríguez">
                            </div>
                        </div>

                        <!-- Row 3: Teléfono + Fecha de Nacimiento -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="uPhone">
                                    <i class="bi bi-telephone me-1"></i>Teléfono
                                </label>
                                <input type="tel" class="form-control" id="uPhone" required placeholder="Ej. 88881234">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="uBirthDate">
                                    <i class="bi bi-calendar-event me-1"></i>Fecha de Nacimiento
                                </label>
                                <input type="date" class="form-control" id="uBirthDate" required>
                            </div>
                        </div>

                        <!-- Row 4: Edad + Fotografía -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="uAge">
                                    <i class="bi bi-hourglass-split me-1"></i>Edad calculada automáticamente
                                </label>
                                <input type="text" class="form-control" id="uAge" readonly placeholder="Se calcula al ingresar la fecha de nacimiento">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="uPhoto">
                                    <i class="bi bi-image me-1"></i>Fotografía de perfil
                                </label>
                                <input type="file" class="form-control" id="uPhoto" accept="image/jpeg,image/png,image/webp">
                                <div class="mt-2 text-center">
                                    <img id="uPhotoPreview" class="img-thumbnail d-none" style="max-height: 120px; object-fit: cover;" alt="Vista previa de la fotografía">
                                </div>
                            </div>
                        </div>

                        <!-- Row 5: Rol -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="uRole">
                                    <i class="bi bi-shield me-1"></i>Rol
                                </label>
                                <select class="form-select" id="uRole">
                                    <option value="Administrator">Administrador</option>
                                    <option value="Engineer">Ingeniero</option>
                                    <option value="Distributor">Comprador</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-info-circle me-1"></i>
                                    El usuario creará su propia contraseña al activar la cuenta con el código enviado a su correo.
                                </p>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" id="saveUserBtn">
                        <i class="bi bi-check-lg me-1"></i>Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">
                        <i class="bi bi-pencil-square me-2"></i>Editar Usuario
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="editUserForm" novalidate>
                        <input type="hidden" id="editUserId">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="editEmail">Correo Electrónico</label>
                                <input type="email" class="form-control" id="editEmail" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="editPhone">Teléfono</label>
                                <input type="tel" class="form-control" id="editPhone" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label" for="editFullName">Nombres</label>
                                <input type="text" class="form-control" id="editFullName" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="editLast1">Apellido 1</label>
                                <input type="text" class="form-control" id="editLast1" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="editLast2">Apellido 2</label>
                                <input type="text" class="form-control" id="editLast2">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="editPhoto">Fotografía de perfil</label>
                                <input type="file" class="form-control" id="editPhoto" accept="image/jpeg,image/png,image/webp">
                                <div class="mt-2 text-center">
                                    <img id="editPhotoPreview" class="img-thumbnail d-none" style="max-height: 120px; object-fit: cover;" alt="Vista previa de la fotografía">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="editRole">Rol</label>
                                <select class="form-select" id="editRole">
                                    <option value="Administrator">Administrador</option>
                                    <option value="Engineer">Ingeniero</option>
                                    <option value="Distributor">Comprador</option>
                                </select>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="saveEditUserBtn">Guardar cambios</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages-controller/AdminDashboardViewController.js" asp-append-version="true"></script>
}