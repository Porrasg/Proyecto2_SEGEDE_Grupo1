@page
@model SEGEDE_Grupo1.WebApp.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Cambio de Contraseña";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <p class="text-muted">Ingresa tu contraseña actual y la nueva contraseña para tu cuenta.</p>

                    <ul class="small text-muted mb-3" id="chgPasswordRequirements">
                        <li>Mínimo 8 caracteres</li>
                        <li>Al menos una mayúscula y una minúscula</li>
                        <li>Al menos un número y un carácter especial</li>
                    </ul>

                    <form id="changePassForm">
                        <div class="mb-3">
                            <label class="form-label" for="chgCurrentPassword">Contraseña Actual</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="chgCurrentPassword" required>
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('chgCurrentPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chgNewPassword">Nueva Contraseña</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="chgNewPassword" required>
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('chgNewPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chgConfirmPassword">Confirmar Nueva Contraseña</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="chgConfirmPassword" required>
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('chgConfirmPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages-controller/ChangePasswordViewController.js" asp-append-version="true"></script>
}
