@page
@model SEGEDE_Grupo1.WebApp.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Cambio de Contraseña";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <p class="text-muted">Ingresa tu correo electrónico y tu contraseña actual. Luego recibirás un OTP para confirmar el cambio.</p>

                    <div id="chgCountdownContainer" class="alert alert-info py-2 small mb-3 d-flex justify-content-between align-items-center d-none">
                        <span>El código expira en:</span>
                        <strong id="chgCountdown">03:00</strong>
                    </div>

                    <form id="changePassForm">
                        <div class="mb-3">
                            <label class="form-label" for="chgEmail">Correo Electrónico</label>
                            <input type="email" class="form-control" id="chgEmail" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chgCurrentPassword">Contraseña Actual</label>
                            <div class="input-group">
                            <input type="password" class="form-control" id="chgCurrentPassword" required>
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('chgCurrentPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chgNewPassword">Nueva Contraseña</label>
                            <div class="input-group">
                            <input type="password" class="form-control" id="chgNewPassword" required>
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('chgNewPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="chgConfirmPassword">Confirmar Nueva Contraseña</label>
                            <div class="input-group">
                            <input type="password" class="form-control" id="chgConfirmPassword" required>
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('chgConfirmPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary">Enviar código OTP</button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <form id="changePassOtpForm" class="d-none">
                        <div class="mb-3">
                            <label class="form-label" for="chgOtpCode">Código OTP</label>
                            <input type="text" class="form-control text-center fs-3 letter-spacing" id="chgOtpCode" maxlength="6" placeholder="000000" required>
                        </div>
                        <div class="d-grid mb-2">
                            <button type="submit" class="btn btn-success">Confirmar cambio</button>
                        </div>
                        <div class="text-center">
                            <button type="button" class="btn btn-link btn-sm" id="resendChangeOtpBtn">Reenviar código</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages-controller/ChangePasswordViewController.js" asp-append-version="true"></script>
}