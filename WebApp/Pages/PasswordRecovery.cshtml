@page
@model SEGEDE_Grupo1.WebApp.Pages.PasswordRecoveryModel
@{
    ViewData["Title"] = "Recuperación de Contraseña";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3">Recuperación de Contraseña</h5>
                    <p class="text-muted">Seleccione cómo desea continuar.</p>
                    <div class="d-grid gap-2">
                        <a class="btn btn-primary" asp-page="/RecoverPassword">Continuar con recuperación</a>
                        <a class="btn btn-outline-primary" asp-page="/ChangePassword">Continuar con cambio de contraseña</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
